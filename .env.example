# GreenPulse Environment Configuration
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./greenpulse.db

# Azure OpenAI (required for AI agent analysis features)
AZURE_API_KEY=your-azure-api-key-here
AZURE_ENDPOINT=https://admin-mm4mum0p-eastus2.cognitiveservices.azure.com/openai/responses
AZURE_API_VERSION=2025-04-01-preview
AZURE_MODEL=gpt-5.2-chat

# SerpAPI (required for patent/news search agents)
SERPAPI_KEY=your-serpapi-key

# Semantic Scholar (optional, improves paper search rate limits)
SEMANTIC_SCHOLAR_KEY=

# Agent scheduling (minutes)
PATENT_SCAN_INTERVAL_MINUTES=60
PAPER_SCAN_INTERVAL_MINUTES=120
NEWS_SCAN_INTERVAL_MINUTES=30
